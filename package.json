{
  "name": "app-tra-cuu-du-lieu",
  "version": "0.1.0",
  "private": true,
  "description": "Internal config-driven lookup portal (NestJS + React monorepo)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build:shared": "pnpm --filter @app/shared run build",
    "predev": "pnpm run build:shared",
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive --filter=./packages/* --filter=./apps/* run build",
    "lint": "eslint .",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "pretest": "pnpm run build:shared",
    "test": "pnpm --recursive --if-present run test",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:seed": "pnpm --filter api run db:seed",
    "db:studio": "pnpm --filter api run db:studio",
    "db:reset": "pnpm --filter api run db:reset",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0",
      "deepmerge-ts": ">=8.0.0",
      "tar": ">=7.5.19",
      "brace-expansion": ">=2.1.2",
      "glob": ">=14.0.2",
      "ip-address": ">=10.7.4",
      "minimatch": ">=11.0.1",
      "pacote": ">=21.5.1",
      "picomatch": ">=4.0.4",
      "sigstore": ">=4.1.1",
      "body-parser": ">=2.4.0",
      "js-yaml": ">=5.4.1",
      "fast-uri": ">=3.1.9",
      "decode-uri-component": ">=0.5.0",
      "stream-json": ">=3.5.0"
    }
  }
}
