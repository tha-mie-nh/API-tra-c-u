        ]
      },
      "output": {
        "timestampField": "updatedAt",
        "sortOrder": "asc",
        "identityField": "citizenId",
        "fields": [
          { "name": "citizenId", "label": "Số CCCD", "from": "so_cccd", "type": "string", "sensitive": true },
          { "name": "fullName", "label": "Họ và tên", "from": "ho_va_ten", "type": "string" },
