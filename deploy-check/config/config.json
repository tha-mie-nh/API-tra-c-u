{
  "version": 1,
  "defaults": {
    "maxResults": 100,
    "pageSize": 20,
    "timeoutMs": 10000,
    "retry": { "attempts": 2, "backoffMs": 300 }
  },
  "datasources": [
    {
      "code": "CITIZEN_BASIC",
      "name": "Tra cứu thông tin công dân",
      "description": "Tra cứu thông tin công dân theo họ tên/ngày sinh/giới tính. (Đã tắt)",
      "type": "info",
      "enabled": false,
      "permissionCode": "api:citizen_basic",
      "transport": {
        "kind": "mock",
        "dataFile": "mock-data/citizen-basic.json",
        "timeoutMs": 10000
      },
      "input": {
        "fields": [
          { "name": "citizenId", "label": "Số CCCD", "type": "string", "required": false, "pattern": "^[0-9]{12}$", "mapTo": "cccd" },
          { "name": "fullName", "label": "Họ và tên", "type": "string", "required": false, "minLength": 2, "maxLength": 100, "mapTo": "ho_ten" },
          { "name": "dob", "label": "Ngày sinh", "type": "date", "required": false, "mapTo": "ngay_sinh", "format": "YYYY-MM-DD" },
          { "name": "gender", "label": "Giới tính", "type": "enum", "required": false,
            "options": [ { "value": "M", "label": "Nam" }, { "value": "F", "label": "Nữ" } ],
            "mapTo": "gioi_tinh" }
        ],
        "atLeastOneOf": ["citizenId", "fullName", "dob", "gender"]
      },
      "output": {
        "timestampField": "recordedAt",
        "sortOrder": "desc",
        "identityField": "citizenId",
        "fields": [
          { "name": "citizenId", "label": "Số CCCD", "from": "cccd", "type": "string", "sensitive": true },
          { "name": "fullName", "label": "Họ và tên", "from": "ho_ten", "type": "string" },
          { "name": "dob", "label": "Ngày sinh", "from": "ngay_sinh", "type": "date" },
          { "name": "gender", "label": "Giới tính", "from": "gioi_tinh", "type": "enum", "valueMap": { "1": "Nam", "2": "Nữ" } },
          { "name": "address", "label": "Địa chỉ", "from": "dia_chi", "type": "string" },
          { "name": "recordedAt", "label": "Thời điểm ghi nhận", "from": "thoi_diem", "type": "datetime" }
        ]
      },
      "limits": { "maxResults": 100, "pageSize": 20 }
    },

    {
      "code": "CITIZEN_EXTENDED",
