          { "name": "fullName", "label": "Họ và tên", "from": "ho_ten", "type": "string" },
          { "name": "direction", "label": "Chiều xuất/nhập cảnh", "from": "chieu", "type": "enum",
            "valueMap": { "XUAT": "Xuất cảnh", "NHAP": "Nhập cảnh" } },
          { "name": "borderGate", "label": "Cửa khẩu / cảng", "from": "cua_khau", "type": "string" },
          { "name": "country", "label": "Quốc gia đối tác", "from": "quoc_gia", "type": "string" },
