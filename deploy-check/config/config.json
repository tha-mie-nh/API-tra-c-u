  },
  "datasources": [
    {
      "code": "CITIZEN_BASIC",
      "name": "Tra cứu thông tin công dân",
      "description": "Tra cứu thông tin công dân theo họ tên/ngày sinh/giới tính. (Đã tắt)",
      "type": "info",
      "enabled": false,
      "permissionCode": "api:citizen_basic",
      "transport": {
        "kind": "http",
        "baseUrl": "${CITIZEN_BASIC_BASE_URL}",
        "path": "/tra-cuu/cong-dan-co-ban",
        "method": "POST",
        "headers": {
          "X-ReqType": "LOOKUP"
        },
        "timeoutMs": 10000,
        "auth": {
          "kind": "apiKeyHeader",
          "header": "X-Access",
          "valueEnv": "CITIZEN_BASIC_API_KEY"
        }
      },
      "input": {
        "fields": [
          {
            "name": "cccd",
            "label": "Số CCCD",
            "type": "string",
            "required": false,
            "pattern": "^[0-9]{12}$"
          },
          {
            "name": "ho_ten",
            "label": "Họ và tên",
            "type": "string",
            "required": false,
            "minLength": 2,
            "maxLength": 100
          },
          {
            "name": "ngay_sinh",
            "label": "Ngày sinh",
            "type": "date",
            "required": false,
            "format": "YYYY-MM-DD"
          },
          {
            "name": "gioi_tinh",
            "label": "Giới tính",
            "type": "enum",
            "required": false,
            "options": [
              {
                "value": "M",
                "label": "Nam"
              },
              {
                "value": "F",
                "label": "Nữ"
              }
            ]
          }
        ],
        "atLeastOneOf": [
          "cccd",
          "ho_ten",
          "ngay_sinh",
          "gioi_tinh"
        ]
      },
      "output": {
        "timestampField": "thoi_diem",
        "sortOrder": "desc",
        "identityField": "cccd",
        "fields": [
          {
            "name": "cccd",
            "label": "Số CCCD",
            "type": "string",
            "sensitive": true
          },
          {
            "name": "ho_ten",
            "label": "Họ và tên",
            "type": "string"
          },
          {
            "name": "ngay_sinh",
            "label": "Ngày sinh",
            "type": "date"
          },
          {
            "name": "gioi_tinh",
            "label": "Giới tính",
            "type": "enum",
            "valueMap": {
              "1": "Nam",
              "2": "Nữ"
            }
          },
          {
            "name": "dia_chi",
            "label": "Địa chỉ",
            "type": "string"
          },
          {
            "name": "thoi_diem",
            "label": "Thời điểm ghi nhận",
            "type": "datetime"
          }
        ],
        "recordsPath": "data",
        "labelField": "ho_ten"
      },
      "limits": {
        "maxResults": 100,
        "pageSize": 20
      }
    },
