          { "name": "fullName", "label": "Họ và tên", "from": "full_name", "type": "string" },
          { "name": "householdNumber", "label": "Số hộ khẩu", "from": "ho_khau_so", "type": "string" },
          { "name": "permanentAddress", "label": "Địa chỉ thường trú", "from": "dia_chi_thuong_tru", "type": "string" },
          { "name": "registrationType", "label": "Loại đăng ký", "from": "loai_dang_ky", "type": "enum",
            "valueMap": { "TT": "Thường trú", "TT2": "Tạm trú" } },
          { "name": "registeredAt", "label": "Ngày đăng ký", "from": "ngay_dang_ky", "type": "datetime" }
        ]
      },
      "limits": { "maxResults": 100, "pageSize": 20 }
    },

    {
      "code": "XUAT_NHAP_CANH",
      "name": "Tra cứu lịch sử xuất nhập cảnh",
