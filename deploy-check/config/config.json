          { "name": "occupation", "label": "Nghề nghiệp", "from": "nghe_nghiep", "type": "string" },
          { "name": "currentAddress", "label": "Nơi ở hiện tại", "from": "noi_o_hien_tai", "type": "string" },
          { "name": "updatedAt", "label": "Cập nhật lúc", "from": "ngay_cap_nhat", "type": "datetime" }
        ]
      },
      "limits": { "maxResults": 100, "pageSize": 20 }
    },

    {
      "code": "CITIZEN_RESIDENCE",
