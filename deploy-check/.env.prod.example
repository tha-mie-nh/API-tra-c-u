# =============================================================================
# .env.prod.example: MẪU cho môi trường PRODUCTION (được commit vào repo).
#
# KHÔNG sửa file này để chạy. Trên MÁY ĐÍCH, tạo file thật từ mẫu:
#     ./init-env-prod.sh            (hoặc ./scripts/init-env-prod.sh trong repo)
# Script sinh secret mới ngay tại chỗ, đặt quyền 600, và in ra những biến bạn còn phải tự điền.
# Kiểm tra trước khi chạy:
#     ./init-env-prod.sh --check
#
# Quy tắc:
#   - .env.prod là file THẬT của đúng một máy, chứa secret: không commit, không copy từ máy khác,
#     không gửi qua chat/email. Mỗi môi trường (lab, prod...) có secret RIÊNG.
#   - Giá trị `__GENERATE__` do script sinh tự động.
#   - Giá trị `__SET_ME__` là biến BẮT BUỘC bạn phải tự điền cho đúng môi trường.
#   - Tránh ký tự `$` trong giá trị (Compose hiểu là biến).
# =============================================================================

# ---- Chế độ chạy của docker-compose.prod.yml ----
# "local-db,db-setup" = tự chạy Postgres trong compose và tự áp dụng schema/seed (mặc định, tự chứa).
# Xóa trống để dùng Postgres có sẵn của tổ chức (khi đó phải sửa DATABASE_URL cho đúng).
COMPOSE_PROFILES=local-db,db-setup

# ---- Ứng dụng ----
NODE_ENV=production
PORT=3000
# Đường dẫn TRONG container (thư mục ./config của máy đích được mount vào /repo/config).
APP_CONFIG_PATH=/repo/config/config.json
# trace|debug|info|warn|error. Production nên để info.
LOG_LEVEL=info
# Tùy chọn: ghi thêm log ra file (cần mount ./logs, đã có trong docker-compose.prod.yml).
LOG_FILE=/var/log/app/api.log
# LOG_TIMEZONE=Asia/Ho_Chi_Minh
# "true" CHỈ KHI có proxy/gateway phía trước lo HTTPS (trình duyệt không gửi cookie Secure qua HTTP thuần).
COOKIE_SECURE=false
# Cổng web công bố ra máy chủ.
WEB_PORT=80

# ---- Postgres (khi dùng COMPOSE_PROFILES=local-db) ----
POSTGRES_USER=app_user
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=app_tra_cuu
# Script dựng lại dòng này từ 3 biến trên (host `postgres` = tên dịch vụ trong compose).
# Nếu dùng PG có sẵn của tổ chức: tự điền thủ công, mật khẩu có ký tự đặc biệt phải mã hóa URL.
DATABASE_URL=postgresql://app_user:__GENERATE__@postgres:5432/app_tra_cuu

# ---- Xác thực ----
# Khóa ký token: PHẢI khác nhau giữa các môi trường và khác nhau giữa hai biến.
JWT_ACCESS_SECRET=__GENERATE__
JWT_REFRESH_SECRET=__GENERATE__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Sai liên tiếp N lần thì khóa tài khoản AUTH_LOCKOUT_MINUTES phút.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Địa chỉ web mà NGƯỜI DÙNG gõ vào trình duyệt, ví dụ http://10.10.10.110 hoặc https://tracuu.noibo.vn.
# (FE và BE đi chung một địa chỉ qua nginx nên thường không kích hoạt CORS, nhưng vẫn phải đặt đúng.)
CORS_ORIGIN=__SET_ME__
# Số bước proxy tin cậy để lấy IP thật của người dùng (nginx của stack = 1). Để trống thì mọi người
# dùng bị tính CHUNG một IP (nginx), nên giới hạn đăng nhập theo IP áp cho cả cơ quan.
TRUST_PROXY=1
# Giới hạn đăng nhập theo IP (mỗi phút) và giới hạn tra cứu theo người dùng (mỗi phút).
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_MS=60000
QUERY_THROTTLE_LIMIT=30
QUERY_THROTTLE_TTL_MS=60000

# ---- Tài khoản quản trị khởi tạo ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Mật khẩu khởi tạo của `admin` (script sinh, lần đăng nhập đầu bị buộc đổi, tối thiểu 12 ký tự).
BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__

# ---- Nhật ký tra cứu ----
# Lưu nguyên văn request/response của từng lượt (chỉ ADMIN xem, mỗi lần xem đều ghi audit).
QUERY_LOG_PAYLOAD_ENABLED=true
QUERY_LOG_PAYLOAD_MAX_BYTES=2097152

# ---- Chặn nguồn dữ liệu mock ----
# Production KHÔNG được bật mock. Chỉ đổi true khi cố ý dùng nguồn mock (demo).
ALLOW_MOCK_DATASOURCES=false

# ---- API upstream (mỗi nguồn dữ liệu đang BẬT trong config/config.json cần cặp biến này) ----
# Tên biến phải khớp `baseUrl: "${...}"` và `auth.valueEnv` trong config.json. Địa chỉ phải TRUY CẬP ĐƯỢC TỪ
# TRONG container `api` (không dùng localhost; dùng tên dịch vụ trong cùng mạng Docker hoặc IP/tên miền thật).
IMMIGRATION_HISTORY_BASE_URL=__SET_ME__
IMMIGRATION_HISTORY_API_KEY=__SET_ME__
PASSPORT_INFO_BASE_URL=__SET_ME__
PASSPORT_INFO_API_KEY=__SET_ME__
DRIVER_LICENSE_BASE_URL=__SET_ME__
DRIVER_LICENSE_API_KEY=__SET_ME__
FACE_PHOTO_BASE_URL=__SET_ME__
FACE_PHOTO_API_KEY=__SET_ME__

# Ví dụ nguồn thử với API mẫu simple-api (chạy cùng mạng Docker, bỏ chú thích nếu config.json có các nguồn SA_*):
# SIMPLE_API_BASE_URL=http://simple-api:8080
# SIMPLE_IMAGES_API_KEY=my-secret-key
# SIMPLE_BADKEY_API_KEY=wrong-key
