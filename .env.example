# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).

# ---- docker-compose.prod.yml only (ignored by `pnpm dev`) ----
# "local-db,db-setup" = docker-compose.prod.yml runs its own Postgres
# container and auto-applies schema/seed (default, self-contained). Clear
# this to connect to an org-owned Postgres instead — then also point
# DATABASE_URL at that instance. See docs/deployment-guide.md "Về Postgres".
COMPOSE_PROFILES=local-db,db-setup

# ---- App ----
NODE_ENV=development
PORT=3000
APP_CONFIG_PATH=./config/config.json
# Structured (pino) log verbosity: trace|debug|info|warn|error. Defaults to
# 'debug' in dev, 'info' in production if unset.
LOG_LEVEL=debug
# Production only: marks the refresh-token cookie `Secure`. Only set to
# "true" once something in front of this deploy actually terminates TLS —
# a browser silently refuses to send a `Secure` cookie over plain HTTP.
# Unset defaults to NODE_ENV === 'production' (back-compat).
COOKIE_SECURE=false

# ---- Postgres (app DB: users/roles/history/audit) ----
# NOTE: host port overridden away from Postgres's default — this WSL2
# machine already has another service bound to 5432. Keep this override; do
# not revert to the default.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_tra_cuu
POSTGRES_PORT=55432
DATABASE_URL=postgresql://app_user:app_password@localhost:55432/app_tra_cuu

# ---- Auth (Phase 03) ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Auto-lock threshold: N failed logins within the counter's lifetime locks
# the account for AUTH_LOCKOUT_MINUTES (separate from an admin's manual lock).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Explicit CORS allow-list for the web origin (comma-separated). Never '*' —
# refresh cookie flow requires credentials:true.
CORS_ORIGIN=http://localhost:5173
# POST /auth/login rate limit. Production should keep this tight (~10/60s);
# local dev/e2e-test .env uses a higher value since the same shared .env
# backs both manual dev testing and the e2e suite's many login calls.
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_MS=60000
QUERY_THROTTLE_LIMIT=30
QUERY_THROTTLE_TTL_MS=60000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# ---- Upstream APIs: all 11 datasources point at the same local demo
# server (scripts/mock-upstream-server.js) — there is no static mock-data
# file mechanism anymore (transport.kind is always "http"). Run the server
# with: node scripts/mock-upstream-server.js
# Swap any one of these to a real upstream later by changing only that
# datasource's own *_BASE_URL/*_API_KEY — nothing else has to change.
CITIZEN_BASIC_BASE_URL=http://localhost:4100
CITIZEN_BASIC_API_KEY=demo-mst-secret-123
CITIZEN_EXT_BASE_URL=http://localhost:4100
CITIZEN_EXT_API_KEY=demo-mst-secret-123
CITIZEN_RESIDENCE_BASE_URL=http://localhost:4100
CITIZEN_RESIDENCE_API_KEY=demo-mst-secret-123
XUAT_NHAP_CANH_BASE_URL=http://localhost:4100
XUAT_NHAP_CANH_API_KEY=demo-mst-secret-123
CCCD_HISTORY_BASE_URL=http://localhost:4100
CCCD_HISTORY_API_KEY=demo-mst-secret-123
VEHICLE_OWNERSHIP_BASE_URL=http://localhost:4100
VEHICLE_OWNERSHIP_API_KEY=demo-mst-secret-123
FAMILY_EVENTS_BASE_URL=http://localhost:4100
FAMILY_EVENTS_API_KEY=demo-mst-secret-123
IMMIGRATION_HISTORY_BASE_URL=http://localhost:4100
IMMIGRATION_HISTORY_API_KEY=demo-mst-secret-123
PASSPORT_INFO_BASE_URL=http://localhost:4100
PASSPORT_INFO_API_KEY=demo-mst-secret-123
DRIVER_LICENSE_BASE_URL=http://localhost:4100
DRIVER_LICENSE_API_KEY=demo-mst-secret-123
FACE_PHOTO_BASE_URL=http://localhost:4100
FACE_PHOTO_API_KEY=demo-mst-secret-123

# ---- Demo upstream server itself (scripts/mock-upstream-server.js) ----
MOCK_UPSTREAM_BASE_URL=http://localhost:4100
MOCK_UPSTREAM_API_KEY=demo-mst-secret-123

# ---- Ports exposed by docker-compose ----
API_PORT=3000
WEB_PORT=5173
