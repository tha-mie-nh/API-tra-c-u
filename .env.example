# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).

# ---- docker-compose.prod.yml only (ignored by `pnpm dev`) ----
# "local-db,db-setup" = docker-compose.prod.yml runs its own Postgres
# container and auto-applies schema/seed (default, self-contained). Clear
# this to connect to an org-owned Postgres instead — then also point
# DATABASE_URL at that instance. See docs/deployment-guide.md "Về Postgres".
COMPOSE_PROFILES=local-db,db-setup

# ---- App ----
NODE_ENV=development
PORT=3000
APP_CONFIG_PATH=./config/config.json
# Structured (pino) log verbosity: trace|debug|info|warn|error. Defaults to
# 'debug' in dev, 'info' in production if unset.
LOG_LEVEL=debug
# Production only: marks the refresh-token cookie `Secure`. Only set to
# "true" once something in front of this deploy actually terminates TLS —
# a browser silently refuses to send a `Secure` cookie over plain HTTP.
# Unset defaults to NODE_ENV === 'production' (back-compat).
COOKIE_SECURE=false

# ---- Postgres (app DB: users/roles/history/audit) ----
# NOTE: host port overridden away from Postgres's default — this WSL2
# machine already has another service bound to 5432. Keep this override; do
# not revert to the default.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_tra_cuu
POSTGRES_PORT=55432
DATABASE_URL=postgresql://app_user:app_password@localhost:55432/app_tra_cuu

# ---- Auth (Phase 03) ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Auto-lock threshold: N failed logins within the counter's lifetime locks
# the account for AUTH_LOCKOUT_MINUTES (separate from an admin's manual lock).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Explicit CORS allow-list for the web origin (comma-separated). Never '*' —
# refresh cookie flow requires credentials:true.
CORS_ORIGIN=http://localhost:5173
# POST /auth/login rate limit. Production should keep this tight (~10/60s);
# local dev/e2e-test .env uses a higher value since the same shared .env
# backs both manual dev testing and the e2e suite's many login calls.
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_MS=60000
QUERY_THROTTLE_LIMIT=30
QUERY_THROTTLE_TTL_MS=60000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password

# ---- Upstream API #1: citizen basic info (mock in Phase 04 until real docs arrive) ----
CITIZEN_BASIC_BASE_URL=http://localhost:4001
CITIZEN_BASIC_API_KEY=change_me_citizen_basic_key

# ---- Upstream API #2: citizen extended info (placeholder, name TBD) ----
CITIZEN_EXT_BASE_URL=http://localhost:4002
CITIZEN_EXT_API_KEY=change_me_citizen_ext_key

# ---- Upstream API #3: citizen residence/household info ----
# NOTE: only used once transport.kind flips from "mock" to "http" for this
# datasource in config/config.json (see reference-config-schema.md).
CITIZEN_RESIDENCE_BASE_URL=http://localhost:4003
CITIZEN_RESIDENCE_API_KEY=change_me_citizen_residence_key

# ---- Real upstream APIs (spec upstream, mock until real host/port/token
# confirmed) — same /find endpoint per API, distinguished by the
# X-Request-Type header (see config.json transport.headers once flipped
# to "http"): find-immihistory, find-passport, find-driverlicense, find-face.
# NOT used while transport.kind="mock" in config.json.
IMMIGRATION_HISTORY_BASE_URL=http://localhost:5050
IMMIGRATION_HISTORY_API_KEY=change_me_immigration_history_key
PASSPORT_INFO_BASE_URL=http://localhost:5050
PASSPORT_INFO_API_KEY=change_me_passport_info_key
DRIVER_LICENSE_BASE_URL=http://localhost:5050
DRIVER_LICENSE_API_KEY=change_me_driver_license_key
FACE_PHOTO_BASE_URL=http://localhost:5050
FACE_PHOTO_API_KEY=change_me_face_photo_key

# ---- Datasource engine (Phase 04) ----
# Mock adapters (transport.kind="mock" in config.json) must never run in
# production. Set to "true" only for a deliberate demo environment.
ALLOW_MOCK_DATASOURCES=false

# ---- Ports exposed by docker-compose ----
API_PORT=3000
WEB_PORT=5173
