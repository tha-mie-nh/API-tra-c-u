# Copy to .env.test and fill in. NEVER commit .env.test (see .gitignore).
# Only used by docker-compose.test.yml — a throwaway, isolated stack that
# pulls a PUBLISHED image from Docker Hub to verify it before telling
# leader "done". Never real secrets; every value here can be a dummy.

# ---- Which published image to verify ----
# Point these at whatever tag you just pushed and want to sanity-check
# before announcing it's ready — e.g. the "old, patched" release:
TEST_API_IMAGE=gthanh/app_tra_cuu:api-v6
TEST_WEB_IMAGE=gthanh/app_tra_cuu:web-v10

# ---- Ports (distinct from dev's 3000/5173/55432 and prod's 80) ----
TEST_WEB_PORT=8081
TEST_POSTGRES_PORT=55434

# ---- Postgres (fully isolated, own volume — dummy creds are fine) ----
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_tra_cuu
DATABASE_URL=postgresql://app_user:app_password@postgres:5432/app_tra_cuu

# ---- App ----
NODE_ENV=production
APP_CONFIG_PATH=/repo/config/config.json
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:8081
ALLOW_MOCK_DATASOURCES=true

# ---- Auth (dummy values — this stack never holds anything real) ----
JWT_ACCESS_SECRET=test_only_access_secret_change_if_paranoid
JWT_REFRESH_SECRET=test_only_refresh_secret_change_if_paranoid
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=test_only_admin_password

# ---- Real upstream API keys (only needed if config.json has an enabled
# transport.kind:"http" datasource — leave as-is otherwise) ----
IMMIGRATION_HISTORY_BASE_URL=http://localhost:4100
IMMIGRATION_HISTORY_API_KEY=unset
PASSPORT_INFO_BASE_URL=http://localhost:4100
PASSPORT_INFO_API_KEY=unset
DRIVER_LICENSE_BASE_URL=http://localhost:4100
DRIVER_LICENSE_API_KEY=unset
FACE_PHOTO_BASE_URL=http://localhost:4100
FACE_PHOTO_API_KEY=unset
